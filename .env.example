# Copy to .env and fill in. Do not commit .env.
# Tokens stay empty here. Fee values are public addresses, not private keys.

# BotFather token. Required. The bot exits if this is empty.
TELEGRAM_BOT_TOKEN=

# Reown (WalletConnect) Cloud project id. Required for /connect. Leave empty to disable pairing.
WALLETCONNECT_PROJECT_ID=

# Telegram username without @. Empty falls back to theBLARCbot.
BLARC_BOT_USERNAME=

# Official support link. Empty falls back to https://t.me/BLARCHub.
BLARC_SUPPORT_URL=

# Official updates link. Empty falls back to https://t.me/BLARCUpdates.
BLARC_UPDATES_URL=

# Comma-separated Telegram user ids allowed to use /broadcast. Empty means nobody.
BLARC_ADMIN_IDS=

# Public EVM address that receives the 1% inside a swap. Not a private key.
BLARC_FEE_ADDRESS=

# Public Solana address. Shown on /fee. Solana swaps are refused.
BLARC_FEE_ADDRESS_SOL=

# Public Robinhood chain fee address (EVM). Shown on /fee. Not a private key.
BLARC_FEE_ADDRESS_ROBINHOOD=

# Public Arc fee address (EVM). Shown on /fee. Not a private key.
BLARC_FEE_ADDRESS_ARC=

# 0x Swap API key (https://dashboard.0x.org). Required for /swap.
# Without it, /swap refuses and does not ask for a signature.
# The fee is swapFeeBps=100 paid to the chain fee wallet inside the swap.
ZEROX_API_KEY=

# Public EVM JSON-RPC for copy-trade watching. Not a private key.
# If empty, an EVM watch is saved and no trades are read until this is set.
BLARC_EVM_RPC_URL=

# Public Solana JSON-RPC for copy-trade watching (getSignaturesForAddress).
# If empty, a Solana watch is saved and no trades are read until this is set.
# Solana copies stay refused: the 1% fee cannot be put in that transaction.
BLARC_SOLANA_RPC_URL=
