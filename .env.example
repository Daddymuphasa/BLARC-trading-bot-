# Copy to .env and fill in. Do not commit .env.
# Tokens stay empty here. Fee values are public addresses, not private keys.

# BotFather token. Required. The bot exits if this is empty.
TELEGRAM_BOT_TOKEN=

# Reown (WalletConnect) Cloud project id. Required for /connect. Leave empty to disable pairing.
WALLETCONNECT_PROJECT_ID=

# Telegram username without @. Empty falls back to theBLARCbot.
BLARC_BOT_USERNAME=

# Official support link. Empty falls back to https://t.me/BLARCHub.
BLARC_SUPPORT_URL=

# Official updates link. Empty falls back to https://t.me/BLARCUpdates.
BLARC_UPDATES_URL=

# Comma-separated Telegram user ids allowed to use /broadcast. Empty means nobody.
BLARC_ADMIN_IDS=

# Public EVM address that receives the 1% inside a swap. Not a private key.
BLARC_FEE_ADDRESS=

# Public Solana address. Stored and shown on /fee. Solana swaps are not live.
BLARC_FEE_ADDRESS_SOL=

# Public Robinhood chain fee address (EVM). Shown on /fee. Not a private key.
BLARC_FEE_ADDRESS_ROBINHOOD=

# Public Arc fee address (EVM). Shown on /fee. Not a private key.
BLARC_FEE_ADDRESS_ARC=
